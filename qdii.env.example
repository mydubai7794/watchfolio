# =============================================================================
# QDII 持仓网站 环境变量模板（全注释，无任何真实值，可放心随仓库分发）
# =============================================================================
# 使用方法：
#   1. 复制本文件为 qdii.env：cp qdii.env.example qdii.env，再填入真实值；
#   2. qdii.env 已被 .gitignore 排除，真实密钥不入库；
#   3. 加载顺序（config.py 的 load_env_file）：项目根 qdii.env（本地开发）
#      优先，其次 /opt/qdii/qdii.env（服务器 systemd EnvironmentFile 位），
#      第一个存在且可读的文件生效；格式 KEY=VALUE 每行一条，# 开头为注释行；
#   4. 数据库 5 键（QDII_DB_*）为必配项；其余按键对应的数据源按需配置，
#      未配置的源自动走各自降级链（见各键说明），不影响服务启动。
# =============================================================================

# -----------------------------------------------------------------------------
# 一、数据库（必配，database.py 全部表结构与 CRUD 依赖）
#     获取渠道：自建 MySQL 5.7+/8.x，建库后填入连接信息
#     不配后果：连接串缺项/为空，服务启动后无法建表读写，核心功能全部不可用
# -----------------------------------------------------------------------------
# QDII_DB_HOST=127.0.0.1
# QDII_DB_PORT=3306
# QDII_DB_USER=
# QDII_DB_PASS=
# QDII_DB_NAME=qdii

# -----------------------------------------------------------------------------
# 二、股票行情网关（自建可选增强，夜盘活价补齐）
#     用途：为无对应交易标的的美股（如 AMKR/PCG/F 等既有代号）补齐夜盘活价，
#          单 symbol 逐只请求，网关层与业务层双鉴权（两值相同）。
#          消费方：portfolio_fetcher.py（QDII_EQUITY_QUOTE_URL / QDII_EQUITY_API_KEY）
#     获取渠道：自建网关后填入地址与业务 key（地址形如 https://<host>/<path>）
#     不配后果：补齐请求安全跳过，对应标的自然回退新浪扩展价定格口径，
#              夜盘该几只无活价（其余标的与整体功能不受影响）
# -----------------------------------------------------------------------------
# QDII_EQUITY_QUOTE_URL=
# QDII_EQUITY_API_KEY=

# -----------------------------------------------------------------------------
# 三、twelvedata 行情 key（美股兜底 + 离岸汇率主价 + 锚点恢复兜底）
#     用途：美股/港股兜底行情批次、离岸美元人民币（USDCNH）主价、
#          冷启动锚点恢复兜底。消费方：portfolio_fetcher.py
#     获取渠道：twelvedata 官网免费注册即得（免费档 8 credits/min，
#              代码侧已按 60s 节流 + 单批 8 symbol 对齐额度）
#     不配后果：兜底/锚点恢复/外汇三条 twelvedata 请求路径全部短路跳过，
#              走既有降级链（离岸汇率无备用主价源，页面汇率卡可能缺数）
# -----------------------------------------------------------------------------
# QDII_TWELVEDATA_API_KEY=

# -----------------------------------------------------------------------------
# 四、东财期指接口 token（期指冷备源，可选）
#     用途：股指期货冷备源参数。消费方：fetcher.py（期指降级链：
#          腾讯 fu 主源 → 东财 futsseapi 冷备 → 新浪 hf_ 深冷备）
#     获取渠道：接口公开，token 参数不强校验，通常留空即可
#     不配后果：传空串，冷备源请求失败时自动沿降级链继续；主源腾讯不受
#              影响，正常态基本无感
# -----------------------------------------------------------------------------
# QDII_EASTMONEY_TOKEN=

# -----------------------------------------------------------------------------
# 五、邮箱 IMAP 凭证（券商成交邮件自动记账）
#     用途：定时拉取券商成交邮件 → 幂等入库 → 自动应用持仓与现金。
#          消费方：email_trader.py（30min 双源同轮）
#     获取渠道：在邮箱服务商设置中开启 IMAP 服务并生成授权码
#              （授权码非登录密码）
#     不配后果：邮件轮询入口安全跳过，成交邮件自动记账/自动应用不可用，
#              成交需人工维护；其余行情/监控功能不受影响
# -----------------------------------------------------------------------------
# QDII_IMAP_USER=
# QDII_IMAP_PASSWORD=

# -----------------------------------------------------------------------------
# 六、长桥 OpenAPI 凭证三件套（锚点恢复主源 + 看板指数主价，可选）
#     用途：冷启动锚点恢复主源（日K收盘价）、盘前盘后扩展价、
#          看板四项指数（VIX/DJI/NDX/SPX）主价。消费方：longport_fetcher.py
#     获取渠道：长桥 OpenAPI 控制台创建应用，取得 App Key / App Secret /
#          Access Token 三个值
#     说明：sys_config 表中的凭证优先热加载，此三键为库缺项时的逐项回落；
#          两处均未配置时视为长桥未配置。
#     不配后果：锚点恢复自动回退 twelvedata 批量兜底、看板指数主价回退
#              Yahoo 兜底；两者也失败时对应指标退化（冷启动锚点带退化标记，
#              开盘自愈）
# -----------------------------------------------------------------------------
# QDII_LP_APP_KEY=
# QDII_LP_APP_SECRET=
# QDII_LP_ACCESS_TOKEN=
