{
  "mcpServers": {
    "mysql_qdii": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@benborla29/mcp-server-mysql"
      ],
      "env": {
        "MYSQL_HOST": "***REMOVED***",
        "MYSQL_PORT": "3914",
        "MYSQL_USER": "*REMOVED*",
        "MYSQL_PASS": "***REMOVED***",
        "MYSQL_DB": "qdii",
        "ALLOW_DDL_OPERATION": "true",
        "SCHEMA_DDL_PERMISSIONS": "qdii:true",
        "ALLOW_INSERT_OPERATION": "true",
        "ALLOW_UPDATE_OPERATION": "true",
        "ALLOW_DELETE_OPERATION": "true"
      }
    }
  }
}
